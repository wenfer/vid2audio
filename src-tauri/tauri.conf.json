{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vid2Audio",
  "version": "0.2.3",
  "identifier": "com.vid2audio.desktop",
  "build": {
    "beforeBuildCommand": "npm --prefix ../frontend run build",
    "frontendDist": "v2a://localhost"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "儿童视频集合的音频提取工具",
    "longDescription": "Vid2Audio 从儿童视频收藏中批量提取音频，支持按剧集编号排序、多音轨选择、试听与打包下载。",
    "publisher": "Vid2Audio",
    "copyright": "Vid2Audio",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {
      "../backend/static": "static/",
      "binaries/": "./"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
