{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vid2Audio",
  "version": "0.2.11",
  "identifier": "com.vid2audio.desktop",
  "build": {
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../frontend"
    },
    "frontendDist": "v2a://localhost"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": "v1Compatible",
    "category": "Utility",
    "shortDescription": "儿童视频集合的音频提取工具",
    "longDescription": "Vid2Audio 从儿童视频收藏中批量提取音频，支持按剧集编号排序、多音轨选择、试听与打包下载。",
    "publisher": "Vid2Audio",
    "copyright": "Vid2Audio",
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "resources": {
      "../backend/static": "static/",
      "binaries/": "./"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 160,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 460,
          "y": 170
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCRkE1Qjk5NkZDMjRFMDYKUldRR1RzSnZtVnY2T3pqVndSL1J3RmVSUkFsMndHQlpuZHNrbjVTZHZsUjc5YXVhT2ZlenVOSmIK",
      "endpoints": [
        "https://github.com/wenfer/vid2audio/releases/latest/download/latest.json"
      ]
    }
  }
}
